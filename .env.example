# Copiar a .env (cp .env.example .env) y cambiar las contraseñas.
# .env está en .gitignore: nunca se sube al repositorio.

CLICKHOUSE_DB=reparto

# Administrador: solo para crear tablas y cargar datos
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=cambiar-admin

# La app solo puede INSERTAR eventos
APP_WRITER_PASSWORD=cambiar-app

# Grafana solo puede LEER
GRAFANA_READER_PASSWORD=cambiar-grafana

# Acceso a la web de Grafana (usuario admin)
GRAFANA_PASSWORD=cambiar-grafana-web
